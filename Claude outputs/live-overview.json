          "queryType": "table",
          "rawSql": "SELECT s.candle_time AS time, s.symbol, (s.close / first_value(s.close) OVER (PARTITION BY s.symbol ORDER BY s.candle_time) - 1) * 100 AS change_pct FROM analytics.silver_prices s WHERE $__timeFilter(s.candle_time) ORDER BY s.symbol, s.candle_time",
