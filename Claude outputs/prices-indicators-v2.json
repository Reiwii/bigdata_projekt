            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT symbol, round(close, 2) AS close, round(rsi_14, 1) AS rsi_14, composite_signal, trend_signal, volatility_signal\nFROM analytics.gold_technical\nWHERE (symbol, candle_time) IN (SELECT symbol, max(candle_time) FROM analytics.gold_technical GROUP BY symbol)\nORDER BY symbol",
