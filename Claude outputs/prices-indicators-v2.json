      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT s.candle_time AS time, s.open, s.high, s.low, s.close, v.volume, t.sma_20, t.bollinger_upper, t.bollinger_lower\nFROM analytics.silver_prices s\nLEFT JOIN analytics.silver_volumes v ON v.symbol = s.symbol AND v.candle_time = s.candle_time\nLEFT JOIN analytics.gold_technical t ON t.symbol = s.symbol AND t.candle_time = s.candle_time\nWHERE s.symbol = '${symbol}' AND $__timeFilter(s.candle_time)\nORDER BY time",
          "refId": "A"
        }
      ]
