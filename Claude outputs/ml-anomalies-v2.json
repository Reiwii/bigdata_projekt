            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(horizon) || ' min' AS horyzont, round(argMax(confidence, predicted_at), 4) AS confidence FROM ml.predictions FINAL GROUP BY horizon ORDER BY horizon",
          "refId": "A"
        }
      ]
    },
