      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_start_time AS time, anomaly_type, round(anomaly_score, 3) AS score, event_candle_count AS candles, round(close, 2) AS close, round(rsi_14, 1) AS rsi_14\nFROM ml.anomalies FINAL\nWHERE symbol = '${symbol}' AND $__timeFilter(event_start_time)\nORDER BY event_start_time DESC",
          "refId": "A"
        }
