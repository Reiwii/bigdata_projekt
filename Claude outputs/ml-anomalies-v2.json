      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT p.target_candle_time AS time, p.predicted_close AS predicted, a.close AS actual\nFROM ml.predictions AS p FINAL\nLEFT JOIN analytics.silver_prices AS a\n  ON a.symbol = p.symbol AND a.candle_time = p.target_candle_time\nWHERE p.symbol = '${symbol}' AND p.horizon = ${horizon}\n  AND $__timeFilter(p.target_candle_time)\nORDER BY time",
          "refId": "A"
        }
      ]
    },
