# Binance Spot API — publiczne dane rynkowe, bez klucza API.
# "market data only" URL (nie trzeba konta): data-api.binance.vision.
BINANCE_BASE_URL=https://data-api.binance.vision

# Lista par (upper-case). Krypto handluje się 24/7, więc dane płyną cały czas.
SYMBOLS=BTCUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Interwał świec: 1s, 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d, 1w
# (dla projektu 1m to dobry balans: wystarczająco danych, bez przytłoczenia).
BINANCE_INTERVAL=1m

# Ile sekund między kolejnymi cyklami pollingu (dla 1m świec sensowne 60 s).
POLL_INTERVAL_SECONDS=60

# Ile ostatnich świec pobieramy w każdym cyklu pollingu (2 = ostatnia zamknięta
# + aktualnie otwarta; silver i tak zdeduplikuje po event_id).
POLL_LIMIT=2

# Backfill przy starcie: ile świec pobrać dla każdego symbolu (0 wyłącza).
# 1000 świec 1m = ~16 h historii, pozwala od razu policzyć SMA20/RSI14.
BACKFILL_LIMIT=1000

# Ujście: "kafka" (domyślne) lub "file"
SINK_TYPE=kafka
KAFKA_BOOTSTRAP_SERVERS=vm1:9092
KAFKA_TOPIC=raw.binance

# Tylko dla SINK_TYPE=file
OUTPUT_FILE=data/raw_binance_kline.txt
